# Copy to .env and fill in. NEVER commit .env. Every value below is a placeholder.

NODE_ENV=development
PORT=4000
# Origin the browser uses to reach the app (used for CORS, CSRF origin check and email links)
WEB_ORIGIN=http://localhost:5173

# MongoDB connection string (Atlas free tier works). Use a least-privilege database user.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# 32+ random characters each. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars
DOWNLOAD_SECRET=replace-with-another-long-random-string-32-chars

# Payments: "sandbox" (local simulator, refused in production) or "razorpay"
PAYMENT_PROVIDER=sandbox
SANDBOX_PAYMENT_SECRET=replace-with-random-string-for-local-sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional AI (core features work without it). Provider: none | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
AI_DAILY_USER_LIMIT=15
AI_DAILY_GLOBAL_LIMIT=300

# Optional email (password reset). Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Oqzra <no-reply@example.com>

# First administrator, created on server start if missing. Change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password-here

SESSION_DAYS=14
DOWNLOAD_LINK_SECONDS=300

# Cashfree (set PAYMENT_PROVIDER=cashfree). CASHFREE_ENV: sandbox | production. Webhook URL: <API origin>/api/webhooks/payments
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
