{
	email chinmaya.dob1999@gmail.com
	servers {
		protocols h1 h2 h3
	}
}

(secure) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Frontend. Fingerprinted build assets come straight from disk with a 1-year cache;
# everything else (pages with SEO tags, /api) goes to the backend.
sahaj.cmcloud.online {
	import secure
	@assets path /assets/* /favicon.svg /logo.svg /icon-192.png /icon-512.png /apple-touch-icon.png
	handle @assets {
		root * /srv
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		reverse_proxy api:4000 {
			health_uri /api/health
			health_interval 15s
		}
	}
}

# Backend API. Browsers that open it directly are sent to the website.
sahaj.api.cmcloud.online {
	import secure
	@notapi not path /api/*
	redir @notapi https://sahaj.cmcloud.online{uri} 302
	reverse_proxy api:4000 {
		health_uri /api/health
		health_interval 15s
	}
}
